{
  "name": "rahhal-app",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "vitest run src/lib/__tests__/rc1.coreJourney.test.ts src/lib/__tests__/rc1.failurePaths.test.ts",
    "test:smoke": "vitest run src/lib/__tests__/rc1.stagingSmoke.test.ts",
    "test:rc1": "vitest run src/lib/__tests__/rc1.coreJourney.test.ts src/lib/__tests__/rc1.failurePaths.test.ts src/lib/__tests__/rc1.stagingSmoke.test.ts",
    "test:post-release": "vitest run src/lib/__tests__/postRelease.verification.test.ts",
    "providers:check": "vitest run src/lib/__tests__/providersCheck.cli.test.ts",
    "audit": "npm audit --audit-level=high",
    "ci": "npm run typecheck && npm run lint && npm run test:run && npm run providers:check && npm run build && npm run audit",
    "preview": "vite preview",
    "test:ai": "vitest run src/lib/__tests__/ai.phaseAB.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/ui": "^4.1.10",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}

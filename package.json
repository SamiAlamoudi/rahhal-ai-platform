{
  "name": "rahhal-app",
  "private": true,
  "version": "1.1.0-rc.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "vitest run src/lib/__tests__/rc1.coreJourney.test.ts src/lib/__tests__/rc1.failurePaths.test.ts",
    "test:smoke": "vitest run src/lib/__tests__/rc1.stagingSmoke.test.ts",
    "test:rc1": "vitest run src/lib/__tests__/rc1.coreJourney.test.ts src/lib/__tests__/rc1.failurePaths.test.ts src/lib/__tests__/rc1.stagingSmoke.test.ts",
    "test:post-release": "vitest run src/lib/__tests__/postRelease.verification.test.ts",
    "providers:check": "vitest run src/lib/__tests__/providersCheck.cli.test.ts",
    "amadeus:check": "node scripts/amadeus-check.mjs",
    "amadeus:live-search": "node scripts/amadeus-live-search.mjs",
    "preview:verify": "vitest run src/lib/__tests__/previewEnvCheck.cli.test.ts",
    "audit": "npm audit --audit-level=high",
    "ci": "npm run typecheck && npm run lint && npm run test:run && npm run providers:check && npm run preview:verify && npm run build && npm run audit",
    "preview": "vite preview",
    "test:ai": "vitest run src/lib/__tests__/ai.phaseAB.test.ts",
    "build:e2e": "VITE_DEMO_AUTH=true VITE_SUPABASE_URL=https://example.supabase.co VITE_SUPABASE_ANON_KEY=eyJhbGciOiJub25lIn0.e30. VITE_PAYMENT_PROVIDER=mock VITE_FLIGHT_PROVIDER=mock VITE_HOTEL_ADAPTER=mock VITE_LIVE_PROVIDERS_ENABLED=false VITE_PROVIDER_MOCK_FALLBACK=true npm run build",
    "build:preview": "VITE_DEPLOY_TARGET=preview VITE_PAYMENT_PROVIDER=mock VITE_LIVE_PROVIDERS_ENABLED=false VITE_PROVIDER_MOCK_FALLBACK=true VITE_FLIGHT_PROVIDER=mock VITE_HOTEL_ADAPTER=mock VITE_BOOKING_PROVIDER=mock VITE_MAPS_PROVIDER=mock VITE_WEATHER_PROVIDER=mock npm run build",
    "test:playwright": "npm run build:e2e && playwright test",
    "test:browser": "npm run test:playwright"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}

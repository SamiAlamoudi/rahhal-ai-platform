# Rahhal AI Platform — environment variables
# Copy to `.env.local` (gitignored) and fill in values.
# Defaults keep providers on mock adapters so the app runs without API keys.
# Never commit real secrets.
# Never put Amadeus client_secret (or any provider OAuth secret) in VITE_* vars.

# ── Supabase (required for auth + persistence + Amadeus token proxy) ────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── RapidAPI (shared key for Booking.com / other RapidAPI hosts) ───────────
VITE_RAPIDAPI_KEY=

# ── Phase W — Real Provider Integration ─────────────────────────────────────
# Feature flags per live provider. When a live call fails / is unavailable,
# AggregationEngine uses priority_fallback → mock adapters automatically.
# Secrets stay server-side (Edge Functions). Never put Maps/Weather/Amadeus
# secrets in VITE_* vars. Booking.com RapidAPI prefers RAPIDAPI_KEY (server)
# and falls back to VITE_RAPIDAPI_KEY for legacy SPA-only use.
#
# Phase X safe default: live providers OFF unless explicitly enabled.
VITE_LIVE_PROVIDERS_ENABLED=false
VITE_PROVIDER_MOCK_FALLBACK=true
# PROVIDER_AMADEUS_LIVE=false
# PROVIDER_BOOKING_LIVE=false
# PROVIDER_GOOGLE_MAPS_LIVE=false
# PROVIDER_OPENWEATHER_LIVE=false
# AMADEUS_ENV=sandbox   # or production | auto
# VITE_DEPLOY_TARGET=development  # development | staging | production

# ── Sprint 56 — Live Travel Provider Layer ──────────────────────────────────
# FeatureRegistry: ai.live_providers / provider.amadeus / provider.duffel / provider.booking
# Default OFF. Structured data only — Conversation Brain authors traveler text.
# PROVIDER_LIVE_LAYER=false
# PROVIDER_DUFFEL_LIVE=false
# Server-only Duffel token (never VITE_DUFFEL_API_TOKEN):
# DUFFEL_API_TOKEN=
# Vercel: vercel env add DUFFEL_API_TOKEN
# GitHub Actions: repository secret DUFFEL_API_TOKEN

# ── Flights (Amadeus) — Sprint 59 ───────────────────────────────────────────
# Full setup guide: documentation/AMADEUS_SETUP.md
# Never put Amadeus secrets in VITE_* vars.
#
# Preferred server / Edge secrets (Self-Service OAuth client credentials):
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
# Legacy aliases (still supported):
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com
# AMADEUS_BASE_URL=https://api.amadeus.com        # production / Enterprise host
# Sprint 61 — real Flight Create Orders (default OFF = provider-side simulated orders):
# AMADEUS_ORDER_LIVE=false
# BOOKING_ORDER_LIVE=false
#
# Vercel Edge Functions that read the secrets above:
#   api/amadeus-token.ts          → POST /api/amadeus-token
#   api/health/providers.ts       → GET  /api/health/providers
#   vercel env add AMADEUS_API_KEY
#   vercel env add AMADEUS_API_SECRET
#
# SPA flags — mock remains the default; enable Amadeus only when configured:
VITE_FLIGHT_ENABLED=true
VITE_FLIGHT_ADAPTER=mock
VITE_FLIGHT_PROVIDER=mock
VITE_AMADEUS_ENABLED=false
# Live Amadeus profile (also requires FeatureRegistry ai.live_providers + provider.amadeus):
# VITE_LIVE_PROVIDERS_ENABLED=true
# PROVIDER_AMADEUS_LIVE=true
# VITE_FLIGHT_PROVIDER=amadeus
# VITE_AMADEUS_ENABLED=true
# VITE_AMADEUS_USE_VERCEL_PROXY=true
#
# Optional overrides:
# VITE_AMADEUS_USE_VERCEL_PROXY=true
# VITE_AMADEUS_TOKEN_URL=/api/amadeus-token
# VITE_AMADEUS_TOKEN_URL=https://your-project.supabase.co/functions/v1/amadeus-token
# VITE_AMADEUS_BASE_URL=https://test.api.amadeus.com
# VITE_FLIGHT_BASE_URL=https://test.api.amadeus.com
# VITE_FLIGHT_TIMEOUT=5000
# VITE_FLIGHT_MAX_RETRIES=2
#
# Verify: npm run amadeus:check && npm run amadeus:live-search

# ── Multi Provider architecture ─────────────────────────────────────────────
# Rahhal never depends on a single supplier. Priority chains with automatic
# failover (timeout / auth / quota / unavailable → next provider).
# Guide: documentation/MULTI_PROVIDER.md
VITE_MULTI_PROVIDER_ENABLED=true
# Flight order (default):
# VITE_FLIGHT_PROVIDER_CHAIN=duffel,travelport,sabre,amadeus_enterprise,mock
# VITE_HOTEL_PROVIDER_CHAIN=booking,expedia,hotelbeds,mock
# VITE_CARS_PROVIDER_CHAIN=rentalcars,mock
# VITE_ACTIVITIES_PROVIDER_CHAIN=viator,getyourguide,mock
# VITE_TRANSFERS_PROVIDER_CHAIN=mock

# ── Hotels (Booking.com via RapidAPI) — Sprint 60 ───────────────────────────
# Live hotel search uses the existing liveProviders Booking.com adapter.
# Server-only credentials (never commit secrets):
# BOOKING_API_KEY=
# RAPIDAPI_KEY=
# BOOKING_RAPIDAPI_KEY=
#
# Mock remains the safe default for Booking Intelligence unless live flags + key
# are enabled (ai.live_providers / provider.booking / PROVIDER_BOOKING_LIVE).
# Adapter: mock | booking
VITE_HOTEL_ENABLED=true
VITE_HOTEL_ADAPTER=mock
VITE_BOOKING_PROVIDER=mock
VITE_BOOKING_HOST=booking-com15.p.rapidapi.com
# Live profile:
# VITE_LIVE_PROVIDERS_ENABLED=true
# PROVIDER_BOOKING_LIVE=true
# VITE_HOTEL_ADAPTER=booking
# VITE_BOOKING_PROVIDER=booking
# Legacy SPA alias (prefer server BOOKING_API_KEY / RAPIDAPI_KEY):
# VITE_RAPIDAPI_KEY=
# VITE_BOOKING_API_KEY=
# Optional override of full API base URL:
# VITE_HOTEL_BASE_URL=https://booking-com15.p.rapidapi.com/api/v1
# VITE_HOTEL_TIMEOUT=5000
# VITE_HOTEL_MAX_RETRIES=2

# ── Rental cars (RentalCars / RapidAPI) ─────────────────────────────────────
# Adapter: mock | rentalcars
VITE_RENTAL_CAR_ENABLED=true
VITE_RENTAL_CAR_ADAPTER=mock
VITE_RENTAL_PROVIDER=mock
VITE_RENTAL_API_KEY=
# Optional:
# VITE_RENTAL_CAR_BASE_URL=
# VITE_RENTAL_CAR_TIMEOUT=5000

# ── Weather (OpenWeather) ───────────────────────────────────────────────────
# Agent WeatherProviderAdapter uses OpenWeather when configured, otherwise
# falls back to mock weather (openweather_mock). Never put the OpenWeather
# API key in VITE_* vars.
#
# Server / Edge Function secrets (required for live OpenWeather):
#   OPENWEATHER_API_KEY=...
#   supabase secrets set OPENWEATHER_API_KEY=...
# Deploy Edge Function: supabase/functions/openweather-proxy
#
# SPA calls that function for current / forecast / One Call / UVI; it never
# sees the API key. Proxy URL defaults to Supabase functions URL when
# VITE_SUPABASE_URL is set.
# Selection: openweather (default when configured) | mock
VITE_WEATHER_ENABLED=true
VITE_WEATHER_ADAPTER=openweather
VITE_WEATHER_PROVIDER=openweather
# Optional overrides:
# VITE_OPENWEATHER_PROXY_URL=https://your-project.supabase.co/functions/v1/openweather-proxy
# VITE_WEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
# VITE_WEATHER_TIMEOUT=10000
#
# Legacy SPA live-search adapter only (do NOT use for secrets going forward):
# VITE_OPENWEATHER_API_KEY=

# ── Maps (Google Maps Platform) ─────────────────────────────────────────────
# Agent ProviderAdapter uses Google Maps when configured, otherwise falls back
# to mock maps (google_maps_mock). Never put the Maps API key in VITE_* vars.
#
# Server / Edge Function secrets (required for live Google Maps):
#   GOOGLE_MAPS_API_KEY=...
#   supabase secrets set GOOGLE_MAPS_API_KEY=...
# Deploy Edge Function: supabase/functions/google-maps-proxy
#
# SPA calls that function for Geocoding / Places / Distance Matrix / Timezone;
# it never sees the API key. Proxy URL defaults to Supabase functions URL when
# VITE_SUPABASE_URL is set.
# Selection: google_maps (default when configured) | mock
VITE_MAPS_PROVIDER=google_maps
# Optional overrides:
# VITE_GOOGLE_MAPS_PROXY_URL=https://your-project.supabase.co/functions/v1/google-maps-proxy
# VITE_GOOGLE_MAPS_TIMEOUT_MS=12000
# VITE_GOOGLE_MAPS_MAX_RETRIES=2

# ── Other domains (mock only today) ─────────────────────────────────────────
VITE_ACTIVITY_ENABLED=true
VITE_ACTIVITY_ADAPTER=mock
VITE_TRANSFER_ENABLED=true
VITE_TRANSFER_ADAPTER=mock
VITE_VISA_ENABLED=true
VITE_VISA_ADAPTER=mock
VITE_CURRENCY_ENABLED=true
VITE_CURRENCY_ADAPTER=mock

# ── Auth / admin ────────────────────────────────────────────────────────────
# Comma-separated Supabase user UUIDs allowed on /admin (in addition to
# app_metadata.role === 'admin').
# VITE_ADMIN_USER_IDS=
# Local demo auth (in-memory session; no Supabase). Dev/RC verification only.
# Never enable in staging/production.
# VITE_DEMO_AUTH=false

# ── AI Chat / Travel AI Agent (text + realtime voice on the same chatEngine) ─
# Chat surface adapter: travel-agent (default) | mock
VITE_CHAT_PROVIDER=travel-agent
# Agent LLM: local (offline Conversation Brain) | openai | anthropic | gemini | deepseek
# OpenAI converse() enables when VITE_OPENAI_API_KEY or VITE_AGENT_OPENAI_API_KEY is set.
# Prefer an Edge proxy in production — do not commit secrets.
VITE_AGENT_LLM_PROVIDER=local
# VITE_OPENAI_API_KEY=
# VITE_AGENT_OPENAI_API_KEY=
# VITE_AGENT_OPENAI_MODEL=gpt-4o-mini
# Voice STT/TTS: auto | web | mock  (auto uses Web Speech when available)
VITE_VOICE_STT_PROVIDER=auto
VITE_VOICE_TTS_PROVIDER=auto

# ── Payments ────────────────────────────────────────────────────────────────
# Client selects provider only. Secrets MUST NOT use VITE_* (except anon key
# to invoke the Edge Function proxy — same pattern as Amadeus).
# Adapter: mock | moyasar
#
# Phase S PaymentOrchestrator uses PaymentAdapter + PaymentSession FSM on top
# of CheckoutOrchestrator. Booking↔payment bridge is library-only (no UI change).
# Phase T TicketOrchestrator issues mock flight e-tickets / hotel vouchers after
# payment capture (mock providers only — no live airline/hotel ticketing APIs).
# Phase U NotificationOrchestrator delivers booking/payment/ticket/trip updates
# via mock email / SMS / WhatsApp providers only (no live notification APIs).
# Phase V TripManager aggregates My Trips / booking history via mock TripRepository
# (no TripPlan API changes; booking/payment/ticketing/notifications stay provider-blind).
#
# PRODUCTION FREEZE: Moyasar code is complete but blocked on business
# verification. Keep mock until docs/PAYMENT_PRODUCTION_TODO.md is done.
VITE_PAYMENT_PROVIDER=mock
# Optional: when true, CheckoutOrchestrator soft-persists to Supabase
# VITE_CHECKOUT_PERSIST=true

# Moyasar — SPA env (no secret key here):
#   VITE_PAYMENT_PROVIDER=moyasar
#   VITE_SUPABASE_URL=https://your-project.supabase.co
#   VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional override of the Edge Function URL:
#   VITE_MOYASAR_PAYMENT_URL=https://your-project.supabase.co/functions/v1/moyasar-payment
#
# Moyasar secrets — set as Supabase Edge Function secrets (never VITE_*):
#   supabase secrets set MOYASAR_SECRET_KEY=sk_test_...
#   supabase secrets set MOYASAR_WEBHOOK_SECRET=your-webhook-shared-secret
# Optional API host override (default https://api.moyasar.com):
#   supabase secrets set MOYASAR_BASE_URL=https://api.moyasar.com
# Optional server-side invoice callback (webhook) URL — do NOT put the SPA return URL here:
#   supabase secrets set MOYASAR_INVOICE_CALLBACK_URL=https://your-project.supabase.co/functions/v1/moyasar-webhook?webhook_secret=...
#
# Hosted flow:
#   1) SPA createPaymentSession → Edge creates Moyasar Invoice → returns invoice.url
#   2) SPA redirects customer to invoice.url (*.moyasar.com)
#   3) Moyasar redirects browser to /checkout/return?orderId=...
#   4) Return page calls refreshPaymentStatus; webhook also updates orders/payment_sessions
#
# Deploy Edge Functions:
#   supabase/functions/moyasar-payment
#   supabase/functions/moyasar-webhook
#
# Webhook verify via header X-Moyasar-Signature or x-rahhal-webhook-secret
# (or query ?webhook_secret=) matching MOYASAR_WEBHOOK_SECRET.
#
# Production enablement checklist: docs/PAYMENT_PRODUCTION_TODO.md

# ── Sprint 67 — Beta Launch Environment ─────────────────────────────────────
# Soft profile for staging/beta. Payments stay mock; live providers are
# feature-flag + secret gated. See docs/SPRINT67_BETA_LAUNCH.md
# VITE_BETA_ENV=beta                 # development | staging | beta | production
# VITE_DEPLOY_TARGET=staging
# VITE_LIVE_PROVIDERS_ENABLED=false  # set true only with Edge secrets + flags
# VITE_PROVIDER_MOCK_FALLBACK=true
# VITE_PAYMENT_PROVIDER=mock         # required for beta (live payments frozen)
# VITE_LOG_LEVEL=info
# Optional sandbox payment secrets (never VITE_* for secret keys):
# STRIPE_SECRET_KEY=
# HYPERPAY_ENTITY_ID=
# HYPERPAY_ACCESS_TOKEN=
# npm run beta:verify

# Sprint 68 — Production Deployment & Launch Automation
# Profiles: development | staging | beta | production
# VITE_DEPLOY_TARGET=production
# Optional launch phase (beta maps to staging env gates + optional live providers):
# VITE_LAUNCH_PHASE=beta
# Edge/server secrets (never VITE_*): AMADEUS_*, DUFFEL_ACCESS_TOKEN, BOOKING_COM_API_KEY,
# STRIPE_SECRET_KEY, HYPERPAY_*, APPLE_PAY_MERCHANT_ID, EMAIL_API_KEY, WHATSAPP_API_TOKEN, FCM_SERVER_KEY
# Verify: npm run deploy:verify && npm run production:verify

# Sprint 69 — Real Beta Operations & Production Monitoring
# npm run ops:verify && npm run beta:ops
# Library: generateBetaOperationsReadinessReport() / buildProductionOpsDashboard()

# Sprint 70 — GA Release
# Rahhal 1.0.0 GA — npm run ga:verify
# Library: buildGAReadinessReport() / runGAReleaseManager()

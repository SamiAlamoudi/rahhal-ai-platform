# Rahhal — PREVIEW environment template (Production MVP)
# Copy values into your preview host secrets / build env. Never commit real secrets.
# Scope: preview deployment ONLY. Do not use for production.

VITE_DEPLOY_TARGET=preview

# ── Supabase (preview / staging project — required for auth) ────────────────
VITE_SUPABASE_URL=https://your-preview-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-preview-anon-key

# ── Payments (MUST remain mock for preview) ─────────────────────────────────
VITE_PAYMENT_PROVIDER=mock

# ── Live providers (MUST remain OFF for preview MVP) ────────────────────────
VITE_LIVE_PROVIDERS_ENABLED=false
VITE_PROVIDER_MOCK_FALLBACK=true
VITE_AMADEUS_ENABLED=false
VITE_FLIGHT_PROVIDER=mock
VITE_FLIGHT_ADAPTER=mock
VITE_HOTEL_ADAPTER=mock
VITE_BOOKING_PROVIDER=mock
VITE_MAPS_PROVIDER=mock
VITE_WEATHER_PROVIDER=mock
VITE_WEATHER_ADAPTER=mock

# Optional demo auth for non-Supabase smoke hosts (local/CI only; prefer real preview Supabase)
# VITE_DEMO_AUTH=true

# NEVER set on the client:
# VITE_AMADEUS_CLIENT_SECRET
# VITE_AMADEUS_CLIENT_ID
# VITE_GOOGLE_MAPS_API_KEY
# VITE_OPENWEATHER_API_KEY
# VITE_MOYASAR_SECRET_KEY
# VITE_MOYASAR_SECRET

# Rahhal — STAGING environment template (Phase X)
# Copy to `.env.staging.local` or your host secrets store. Never commit secrets.
# Safe defaults: mock payments, live providers OFF unless explicitly enabled.

VITE_DEPLOY_TARGET=staging

# ── Supabase (staging project) ──────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-staging-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-staging-anon-key

# ── Payments (MUST remain mock for staging until production freeze lifts) ───
VITE_PAYMENT_PROVIDER=mock

# ── Live providers (OFF by default) ─────────────────────────────────────────
VITE_LIVE_PROVIDERS_ENABLED=false
VITE_PROVIDER_MOCK_FALLBACK=true
VITE_AMADEUS_ENABLED=false
VITE_FLIGHT_PROVIDER=mock
VITE_FLIGHT_ADAPTER=mock
VITE_HOTEL_ADAPTER=mock
VITE_BOOKING_PROVIDER=mock
VITE_MAPS_PROVIDER=mock
VITE_WEATHER_PROVIDER=mock
VITE_WEATHER_ADAPTER=mock

# Optional RapidAPI (hotels) — prefer server RAPIDAPI_KEY on Edge, not VITE_*
# VITE_RAPIDAPI_KEY=

# NEVER set:
# VITE_AMADEUS_CLIENT_SECRET
# VITE_GOOGLE_MAPS_API_KEY
# VITE_OPENWEATHER_API_KEY
# VITE_MOYASAR_SECRET_KEY

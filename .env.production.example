# Rahhal — PRODUCTION environment template (Phase X)
# Use a secrets manager / host env. Never commit real values.
# Controlled release defaults: mock payments; live providers OFF until explicitly enabled.

VITE_DEPLOY_TARGET=production

VITE_SUPABASE_URL=https://your-production-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-production-anon-key

# PRODUCTION FREEZE — keep mock until docs/PAYMENT_PRODUCTION_TODO.md is complete
VITE_PAYMENT_PROVIDER=mock

# Live providers remain off unless a release explicitly flips flags after checklist sign-off
VITE_LIVE_PROVIDERS_ENABLED=false
VITE_PROVIDER_MOCK_FALLBACK=true
VITE_AMADEUS_ENABLED=false
VITE_FLIGHT_PROVIDER=mock
VITE_MAPS_PROVIDER=mock
VITE_WEATHER_PROVIDER=mock
VITE_HOTEL_ADAPTER=mock

# Edge / server secrets (Supabase secrets — never VITE_*):
#   AMADEUS_CLIENT_ID / AMADEUS_CLIENT_SECRET / AMADEUS_ENV=production|sandbox
#   GOOGLE_MAPS_API_KEY
#   OPENWEATHER_API_KEY
#   RAPIDAPI_KEY (Booking.com)
#   MOYASAR_* only after payment freeze lift
#   OPS_ALLOWED_ORIGINS=https://app.rahhal.example
